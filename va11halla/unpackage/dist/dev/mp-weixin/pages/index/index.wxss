page.data-v-1cf27b2a,
view.data-v-1cf27b2a,
text.data-v-1cf27b2a,
input.data-v-1cf27b2a,
button.data-v-1cf27b2a {
  font-family: "PingFang SC", "Helvetica Neue", sans-serif;
}
.index.data-v-1cf27b2a {
  background-color: #f5f3fe;
  /* 与功能页一致的淡紫色背景 */
  min-height: 100vh;
  padding: 20px;
  color: #333;
  font-family: "PingFang SC", "Helvetica Neue", sans-serif;
}
.banner.data-v-1cf27b2a {
  margin-bottom: 20px;
  border-radius: 12rpx;
  /* 给整个 banner 区域加圆角 */
  overflow: hidden;
  /* 确保超出部分被隐藏 */
}
.banner-image.data-v-1cf27b2a {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}
.uni-section.data-v-1cf27b2a {
  margin-bottom: 24px;
  background-color: #fff;
  border-radius: 10px;
  box-shadow: 0 1px 6px rgba(0, 0, 0, 0.04);
  padding: 16px;
  border-left: 6px solid #7f5fff;
}
.uni-section__title.data-v-1cf27b2a {
  color: #5e5eac !important;
  font-weight: bold;
  font-size: 18px;
}
.grid.data-v-1cf27b2a {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220rpx, 1fr));
  gap: 20px;
  padding: 10px;
}
.grid-item.data-v-1cf27b2a {
  background-color: #ffffff;
  border-radius: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  text-align: center;
  padding: 20px;
  transition: all 0.3s;
}
.grid-item.data-v-1cf27b2a:hover {
  transform: scale(1.02);
}
.icon.data-v-1cf27b2a {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 10rpx;
}
.label.data-v-1cf27b2a {
  color: #333;
  font-size: 16px;
  font-weight: bold;
}
.tag.data-v-1cf27b2a {
  display: inline-block;
  background-color: #7f5fff;
  color: #fff;
  font-size: 12px;
  padding: 2px 6px;
  border-radius: 4px;
  margin-top: 6px;
}